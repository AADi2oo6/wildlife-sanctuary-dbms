generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Zone {
  zone_id            Int         @id @default(autoincrement())
  name               String      @unique
  climate            ClimateType @default(TROPICAL)
  camera_traps_count Int         @default(0)
  ticket_price       Decimal     @db.Decimal(10, 2)
  enclosures         Enclosure[]
  tickets            Ticket[]
  iot_nodes          IotNode[]

  @@map("zones")
}

model Enclosure {
  enclosure_id      Int      @id @default(autoincrement())
  zone_id           Int
  code_name         String   @unique
  max_capacity      Int
  current_occupancy Int      @default(0)
  animals           Animal[]
  zone              Zone     @relation(fields: [zone_id], references: [zone_id], onDelete: Cascade)

  @@map("enclosures")
}

model Animal {
  animal_id       Int          @id @default(autoincrement())
  enclosure_id    Int?
  species         String       @db.VarChar(100)
  scientific_name String?      @db.VarChar(150)
  nickname        String?      @db.VarChar(100)
  birth_date      DateTime?    @db.Date
  date_joined     DateTime     @default(now()) @db.Date
  health_status   AnimalStatus @default(HEALTHY)
  surveys         Survey[]
  enclosure       Enclosure?   @relation(fields: [enclosure_id], references: [enclosure_id])
  health_logs     HealthLog[]

  @@index([health_status])
  @@map("animals")
}

model Survey {
  survey_id      BigInt   @id @default(autoincrement())
  animal_id      Int
  survey_date    DateTime @default(now())
  sighting_count Int      @default(1)
  latitude       Decimal  @db.Decimal(9, 6)
  longitude      Decimal  @db.Decimal(9, 6)
  animal         Animal   @relation(fields: [animal_id], references: [animal_id], onDelete: Cascade)

  @@index([animal_id, survey_date(sort: Desc)])
  @@map("animal_surveys")
}

model Visitor {
  visitor_id    Int        @id @default(autoincrement())
  email         String     @unique @db.VarChar(150)
  password_hash String     @db.VarChar(255)
  first_name    String     @db.VarChar(100)
  last_name     String     @db.VarChar(100)
  age           Int
  created_at    DateTime   @default(now())
  role          Role       @default(VISITOR) @map("role")
  feedbacks     Feedback[]
  staff         Staff?
  tickets       Ticket[]

  @@map("visitors")
}

model Ticket {
  ticket_id    BigInt   @id @default(autoincrement())
  visitor_id   Int
  zone_id      Int
  booking_date DateTime @default(now())
  base_cost    Decimal  @db.Decimal(10, 2)
  gst_amount   Decimal  @default(0.00) @db.Decimal(10, 2)
  total_amount Decimal  @default(0.00) @db.Decimal(10, 2)
  visitor      Visitor  @relation(fields: [visitor_id], references: [visitor_id])
  zone         Zone     @relation(fields: [zone_id], references: [zone_id])

  @@map("tickets")
}

model Feedback {
  feedback_id  Int      @id @default(autoincrement())
  visitor_id   Int
  rating       Int
  comments     String
  submitted_at DateTime @default(now())
  visitor      Visitor  @relation(fields: [visitor_id], references: [visitor_id], onDelete: Cascade)

  @@map("feedbacks")
}

model ContactMessage {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(150)
  email        String   @db.VarChar(150)
  subject      String   @db.VarChar(200)
  message      String
  submitted_at DateTime @default(now())
  is_read      Boolean  @default(false)

  @@map("contact_messages")
}


model Staff {
  staff_id      Int         @id
  first_name    String      @db.VarChar(100)
  last_name     String      @db.VarChar(100)
  role          String      @db.VarChar(50)
  email         String      @unique @db.VarChar(150)
  medical_cases HealthLog[]
  visitors      Visitor     @relation(fields: [staff_id], references: [visitor_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("staff")
}

model HealthLog {
  log_id            BigInt   @id @default(autoincrement())
  animal_id         Int
  veterinarian_id   Int
  logged_at         DateTime @default(now())
  diagnosis         String
  treatment         String
  require_isolation Boolean  @default(false)
  animal            Animal   @relation(fields: [animal_id], references: [animal_id], onDelete: Cascade)
  veterinarian      Staff    @relation(fields: [veterinarian_id], references: [staff_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([animal_id, logged_at(sort: Desc)])
  @@map("health_logs")
}

enum AnimalStatus {
  HEALTHY
  UNDER_CARE
  CRITICAL
  QUARANTINED
}

enum ClimateType {
  TROPICAL
  TEMPERATE
  ARID
  WETLAND
  ALPINE
}

enum StaffRole {
  RANGER
  VETERINARIAN
  ADMINISTRATOR
  FIELD_ANALYST
}

enum Role {
  VISITOR
  STAFF
  ADMIN
}

enum NodeStatus {
  ACTIVE
  ALERT
  OFFLINE
  MAINTENANCE
}

model IotNode {
  node_id           Int         @id @default(autoincrement())
  device_uid        String      @unique @db.VarChar(100)
  name              String      @db.VarChar(150)
  latitude          Decimal     @db.Decimal(9, 6)
  longitude         Decimal     @db.Decimal(9, 6)
  status            NodeStatus  @default(ACTIVE)
  battery_level     Int         @default(100)
  sensor_type       String?     @default("ACOUSTIC_VISION") @db.VarChar(100)
  com_port          String?     @db.VarChar(50)
  baud_rate         Int?        @default(115200)
  camera_url        String?     @db.VarChar(255)
  camera_stream_url String?     @db.VarChar(255)
  is_listening      Boolean     @default(false)
  notes             String?     @db.Text
  last_ping         DateTime?   @default(now())
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
  zone_id           Int?
  zone              Zone?       @relation(fields: [zone_id], references: [zone_id], onDelete: SetNull)
  custom_area_id    Int?
  custom_area       CustomArea? @relation(fields: [custom_area_id], references: [area_id], onDelete: SetNull)

  trigger_events IotTriggerEvent[]

  @@index([status])
  @@map("iot_nodes")
}

model IotTriggerEvent {
  event_id           Int      @id @default(autoincrement())
  node_id            Int
  node               IotNode  @relation(fields: [node_id], references: [node_id], onDelete: Cascade)
  trigger_type       String   @db.VarChar(100)
  severity           String   @default("ALERT") @db.VarChar(50)
  decibel_level      Decimal? @db.Decimal(5, 2)
  confidence         Decimal? @db.Decimal(4, 3)
  details            String?  @db.Text
  audio_sample_url   String?  @db.VarChar(255)
  image_snapshot_url String?  @db.VarChar(255)
  audio_ai_analysis  Json?
  vision_ai_analysis Json?
  vision_score       Decimal? @db.Decimal(4, 3)
  is_manual          Boolean  @default(false)
  triggered_at       DateTime @default(now())
  created_at         DateTime @default(now())

  @@index([node_id, triggered_at])
  @@map("iot_trigger_events")
}

model CustomArea {
  area_id     Int       @id @default(autoincrement())
  name        String    @db.VarChar(150)
  area_type   String    @default("FOREST") @db.VarChar(100)
  coordinates Json
  area_sq_km  Decimal   @db.Decimal(12, 2)
  color       String    @default("#22c55e") @db.VarChar(30)
  climate     String?   @db.VarChar(100)
  description String?   @db.Text
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  iot_nodes   IotNode[]

  @@map("custom_areas")
}

